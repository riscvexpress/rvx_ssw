{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git apply:*)",
      "Bash(git am:*)",
      "Bash(git config:*)",
      "Bash(git remote:*)",
      "Bash(git submodule:*)",
      "Bash(git worktree:*)",
      "Bash(git filter-branch:*)",
      "Bash(git gc:*)",
      "Bash(git reflog:*)",
      "Bash(git init:*)",
      "Bash(git clone:*)",
      "Bash(git -C:*)",
      "Bash(git --git-dir:*)",
      "Bash(git --work-tree:*)",
			"Edit(.git/**)",
			"Edit(/)",
			"Edit(/etc/**)",
			"Edit(/root/**)",
			"Bash(cd /)",
			"Bash(cd /**)",
			"Bash(rm -rf /)",
			"Bash(rm -rf /*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)"
    ]
  }
}
