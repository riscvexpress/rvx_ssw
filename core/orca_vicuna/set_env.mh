ifdef RVX_COMPILER_BASIC
CROSS_COMPILE = ${RVX_COMPILER_BASIC}
RISCV_ARCH=rv32im
RISCV_ABI=ilp32
CFLAGS += -march=${RISCV_ARCH} -mabi=${RISCV_ABI}
LD_FLAGS += -march=${RISCV_ARCH} -mabi=${RISCV_ABI}
endif

ifdef RVX_COMPILER_XPACK
CROSS_COMPILE = ${RVX_COMPILER_XPACK}
RISCV_ARCH=rv32im_zicsr_zifencei_zve32x
RISCV_ABI=ilp32
CFLAGS += -march=${RISCV_ARCH} -mabi=${RISCV_ABI} -mtune=rocket
LD_FLAGS += -march=${RISCV_ARCH} -mabi=${RISCV_ABI} -mtune=rocket -Wl,--no-warn-rwx-segments
endif

INCLUDES += -I${RVX_SSW_HOME}/core/orca_vicuna
ASM_SRC += ${RVX_SSW_HOME}/core/orca_vicuna/start.S
ASM_SRC += ${RVX_SSW_HOME}/core/orca_vicuna/orca_vicuna.S
ifeq ($(USE_FREERTOS),true)
	ASM_SRC += ${RVX_SSW_HOME}/core/common/portasm.S
else
	ASM_SRC += ${RVX_SSW_HOME}/core/common/entry.S
endif
C_SRC += ${RVX_SSW_HOME}/core/orca_vicuna/core_dependent.c

include ${RVX_SSW_HOME}/riscv/env/set_env.mh
